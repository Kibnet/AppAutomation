<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:ui="clr-namespace:AppAutomation.Recorder.Avalonia.UI"
             x:Class="AppAutomation.Recorder.Avalonia.UI.RecorderOverlay">
    <UserControl.Resources>
        <SolidColorBrush x:Key="RecorderOverlayBackground">#F4F6F8</SolidColorBrush>
        <SolidColorBrush x:Key="RecorderSurfaceBackground">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="RecorderScenarioFieldBackground">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="RecorderOverlayBorder">#CBD5E1</SolidColorBrush>
        <SolidColorBrush x:Key="RecorderText">#0F172A</SolidColorBrush>
        <SolidColorBrush x:Key="RecorderAccent">#0F766E</SolidColorBrush>
        <SolidColorBrush x:Key="RecorderMuted">#475569</SolidColorBrush>
        <SolidColorBrush x:Key="RecorderWarning">#B45309</SolidColorBrush>
        <SolidColorBrush x:Key="RecorderDanger">#B91C1C</SolidColorBrush>
    </UserControl.Resources>

    <Border Padding="10"
            Background="{DynamicResource RecorderOverlayBackground}"
            BorderBrush="{DynamicResource RecorderOverlayBorder}"
            BorderThickness="1">
        <Grid>
            <Grid x:Name="ExpandedPanel"
                  RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                  RowSpacing="8">
                <Border x:Name="ScenarioSelectionPanel"
                        Grid.Row="0"
                        Padding="8,0,8,6"
                        Background="{DynamicResource RecorderSurfaceBackground}"
                        BorderBrush="{DynamicResource RecorderOverlayBorder}"
                        BorderThickness="1"
                        IsVisible="False">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="5">
                        <ProgressBar x:Name="ScenarioScanProgress"
                                     Grid.Row="0"
                                     Height="3"
                                     Margin="-8,0,-8,0"
                                     IsIndeterminate="True"
                                     automation:AutomationProperties.AutomationId="RecorderScenarioScanProgress" />
                        <TextBlock x:Name="ScenarioScanStatus"
                                   Grid.Row="1"
                                   FontSize="12"
                                   Foreground="{DynamicResource RecorderMuted}"
                                   Text="Идет сканирование…"
                                   automation:AutomationProperties.AutomationId="RecorderScenarioScanStatus" />
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,*,*"
                              ColumnSpacing="8">
                            <Grid.Styles>
                                <Style Selector=":is(TemplatedControl).scenario-field">
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="3" />
                                    <Setter Property="Background" Value="{DynamicResource RecorderScenarioFieldBackground}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource RecorderOverlayBorder}" />
                                    <Setter Property="Foreground" Value="{DynamicResource RecorderText}" />
                                </Style>
                                <Style Selector="TextBox.scenario-field">
                                    <Setter Property="UseFloatingPlaceholder" Value="False" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </Grid.Styles>
                            <StackPanel Grid.Column="0"
                                        Spacing="3">
                                <TextBlock Text="Сущность"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource RecorderText}" />
                                <Grid x:Name="ScenarioEntityField">
                                    <TextBox x:Name="ScenarioEntityTextBox"
                                             Classes="scenario-field"
                                             Padding="8,0,32,0"
                                             automation:AutomationProperties.Name="Сущность"
                                             automation:AutomationProperties.AutomationId="RecorderScenarioEntity" />
                                    <Button x:Name="ScenarioEntityOpenButton"
                                            Width="30"
                                            Height="30"
                                            MinHeight="0"
                                            MinWidth="0"
                                            Margin="0,1,1,1"
                                            HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="2"
                                            IsEnabled="{Binding #ScenarioEntityTextBox.IsEnabled}"
                                            Focusable="False"
                                            automation:AutomationProperties.Name="Показать сущности"
                                            automation:AutomationProperties.AutomationId="RecorderScenarioEntityOpen">
                                        <Border Width="8"
                                                Height="8"
                                                Margin="0,0,0,5"
                                                BorderBrush="{DynamicResource RecorderMuted}"
                                                BorderThickness="0,0,1,1"
                                                IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="45" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Button>
                                    <Popup x:Name="ScenarioEntityPopup"
                                           Placement="BottomEdgeAlignedLeft"
                                           ShouldUseOverlayLayer="True"
                                           IsLightDismissEnabled="True"
                                           OverlayDismissEventPassThrough="True">
                                        <Border x:Name="ScenarioEntityResults"
                                                Padding="4"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                BorderBrush="{DynamicResource RecorderOverlayBorder}"
                                                Background="{DynamicResource RecorderSurfaceBackground}">
                                            <Grid>
                                                <TextBlock x:Name="ScenarioEntityNoResults"
                                                           Margin="6"
                                                           Text="Нет совпадений"
                                                           Foreground="{DynamicResource RecorderMuted}" />
                                                <ListBox x:Name="ScenarioEntityList"
                                                         MaxHeight="240"
                                                         Focusable="False"
                                                         Background="Transparent"
                                                         BorderThickness="0">
                                                    <ListBox.Styles>
                                                        <Style Selector="ListBoxItem">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ListBox.Styles>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="ui:RecorderScenarioEntity">
                                                            <Button Content="{Binding Label}"
                                                                    Focusable="False"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left"
                                                                    Padding="8,4"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Click="OnScenarioEntityItemClick"
                                                                    automation:AutomationProperties.Name="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Spacing="3">
                                <TextBlock Text="Операция"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource RecorderText}" />
                                <ComboBox x:Name="ScenarioDestinationComboBox"
                                          Classes="scenario-field"
                                          HorizontalAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          PlaceholderText="Выберите операцию"
                                          automation:AutomationProperties.Name="Операция"
                                          automation:AutomationProperties.AutomationId="RecorderScenarioDestination">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:RecorderScenarioOperation">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Spacing="3">
                                <TextBlock Text="Scenario name"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource RecorderText}" />
                                <TextBox x:Name="ScenarioNameTextBox"
                                         Classes="scenario-field"
                                         automation:AutomationProperties.AutomationId="RecorderScenarioName" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="3"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8">
                            <Button x:Name="ResetScenarioTargetButton"
                                    Grid.Column="0"
                                    Padding="8,3"
                                    Content="Reset fields"
                                    automation:AutomationProperties.AutomationId="RecorderResetScenarioTarget" />
                            <TextBlock x:Name="ScenarioSelectionErrorText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource RecorderDanger}"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.AutomationId="RecorderScenarioSelectionError" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
                      ColumnSpacing="8">
                    <Button x:Name="RecordButton"
                            Grid.Column="0"
                            Padding="10,4"
                            MinWidth="72"
                            Content="Record"
                            automation:AutomationProperties.AutomationId="RecordButton" />
                    <Button x:Name="ClearButton"
                            Grid.Column="1"
                            Padding="10,4"
                            Content="Clear" />
                    <Button x:Name="SaveButton"
                            Grid.Column="2"
                            Padding="10,4"
                            Content="Save"
                            automation:AutomationProperties.AutomationId="SaveButton" />
                    <Button x:Name="ExportButton"
                            Grid.Column="3"
                            Padding="10,4"
                            Content="Export..." />
                    <Button x:Name="SettingsButton"
                            Grid.Column="4"
                            Padding="10,4"
                            Content="Settings" />
                    <Button x:Name="CheckButton"
                            Grid.Column="5"
                            Padding="10,4"
                            Content="Check"
                            automation:AutomationProperties.AutomationId="RecorderCheckButton" />
                    <Button x:Name="GenerateValueButton"
                            Grid.Column="6"
                            Padding="10,4"
                            Content="Value"
                            automation:AutomationProperties.AutomationId="RecorderGenerateValueButton" />
                    <TextBlock x:Name="StepCounter"
                               Grid.Column="7"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource RecorderAccent}"
                               FontWeight="SemiBold"
                               Text="0 steps" />
                    <TextBlock x:Name="ValidationBadgeText"
                               Grid.Column="8"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="VALID" />
                    <TextBlock x:Name="StatusText"
                               Grid.Column="9"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource RecorderMuted}"
                               TextWrapping="Wrap" />
                </Grid>

                <TextBlock x:Name="PreviewText"
                           Grid.Row="2"
                           FontFamily="Cascadia Mono, Consolas"
                           Foreground="{DynamicResource RecorderText}"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="3"
                            Spacing="4">
                    <TextBlock x:Name="SessionSummaryText"
                               Foreground="{DynamicResource RecorderMuted}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Text="Scenario file"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource RecorderText}" />
                        <Button x:Name="RestoreAutosaveButton"
                                Padding="8,3"
                                Content="Restore draft"
                                IsVisible="False"
                                automation:AutomationProperties.AutomationId="RecorderRestoreAutosave" />
                    </StackPanel>
                    <TextBlock x:Name="ScenarioPathText"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{DynamicResource RecorderText}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Diagnostic log"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource RecorderText}" />
                    <Grid ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="8">
                        <CheckBox x:Name="DiagnosticLogCheckBox"
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Content="Write to file" />
                        <Button x:Name="CopyDiagnosticLogPathButton"
                                Grid.Column="1"
                                Padding="8,3"
                                Content="Copy path" />
                        <TextBlock x:Name="DiagnosticLogPathText"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{DynamicResource RecorderMuted}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="4"
                        Padding="8"
                        Background="{DynamicResource RecorderSurfaceBackground}"
                        BorderBrush="{DynamicResource RecorderOverlayBorder}"
                        BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,*"
                          RowSpacing="6">
                        <TextBlock Grid.Row="0"
                                   Text="Recorded Steps"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource RecorderText}" />
                        <TextBlock x:Name="JournalEmptyText"
                                   Grid.Row="1"
                                   Foreground="{DynamicResource RecorderMuted}"
                                   Text="No recorded steps yet." />
                        <Grid x:Name="StepJournalViewport" Grid.Row="2" ClipToBounds="True">
                            <ScrollViewer x:Name="StepJournalScrollViewer"
                                          Focusable="True"
                                          automation:AutomationProperties.AutomationId="RecorderStepJournal"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="StepJournalPanel" Spacing="6" />
                            </ScrollViewer>
                            <TextBlock x:Name="StepDropIndicator"
                                    automation:AutomationProperties.AutomationId="RecorderStepDropIndicator"
                                    automation:AutomationProperties.Name="Step insertion position"
                                    Height="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{DynamicResource RecorderAccent}"
                                    IsVisible="False" IsHitTestVisible="False" ZIndex="10" />
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="ShortcutText"
                           Grid.Row="5"
                           Foreground="{DynamicResource RecorderMuted}"
                           TextWrapping="Wrap" />
            </Grid>

        </Grid>
    </Border>
</UserControl>
